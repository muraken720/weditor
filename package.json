{
  "name": "weditor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "encoding-japanese": "2.3.0"
  },
  "description": "An offline text editor distributed as a single HTML file.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
